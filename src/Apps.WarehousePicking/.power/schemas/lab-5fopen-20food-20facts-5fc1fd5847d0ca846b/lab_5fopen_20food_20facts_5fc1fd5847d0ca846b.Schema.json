  "properties": {
    "xrmConnectorId": "796f58f9-aeb5-ba33-a08b-1dfba0d9062f",
    "displayName": "Open Food Facts",
    "iconUri": "https://defaulticons.powerapps.com/defaulticons/api-dedicated.png",
    "iconBrandColor": "#007ee5",
    "contact": {},
    "license": {},
    "apiEnvironment": "Shared",
    "isCustomApi": true,
    "blobUrisAreProxied": false,
    "connectionParameters": {},
    "swagger": {
      "swagger": "2.0",
      "info": {
        "title": "Open Food Facts",
        "description": "Look up product data by barcode from the Open Food Facts public database.",
        "version": "1.0"
      },
      "host": "74f7855f31b2ef14a19246c2a132db.17.environment.api.powerplatform.com",
      "basePath": "/connectors/runtime/invoke/scalegroups/usa002/shards/14/apis/lab-5fopen-20food-20facts-5fc1fd5847d0ca846b/connections/",
      "schemes": [
        "https"
      ],
      "consumes": [],
      "produces": [
        "application/json"
      ],
      "paths": {
        "/{connectionId}/product/{barcode}.json": {
          "get": {
            "summary": "Get product by barcode",
            "description": "Looks up a product by its EAN/UPC barcode and returns its name, brand, quantity, and image URL.",
            "operationId": "GetProductByBarcode",
            "x-ms-visibility": "important",
            "parameters": [
              {
                "name": "connectionId",
                "in": "path",
                "required": true,
                "x-ms-visibility": "internal",
                "type": "string"
              },
              {
                "name": "barcode",
                "in": "path",
                "required": true,
                "type": "string",
                "description": "The product's EAN-13 or UPC-A barcode.",
                "x-ms-summary": "Barcode"
              }
            ],
            "responses": {
              "200": {
                "description": "Product found",
                "schema": {
                  "$ref": "#/definitions/Product"
                }
              },
              "404": {
                "description": "No product found for this barcode"
              }
            }
          }
        },
        "/{connectionId}/product-image": {
          "get": {
            "summary": "Get product image",
            "description": "Proxies the bytes of an Open Food Facts image URL for callers that cannot load the external URL directly.",
            "operationId": "GetProductImage",
            "x-ms-visibility": "important",
            "parameters": [
              {
                "name": "connectionId",
                "in": "path",
                "required": true,
                "x-ms-visibility": "internal",
                "type": "string"
              },
              {
                "name": "imageUrl",
                "in": "query",
                "required": true,
                "type": "string",
                "description": "The image URL returned by GetProductByBarcode.",
                "x-ms-summary": "Image URL"
              }
            ],
            "produces": [
              "image/jpeg",
              "image/png"
            ],
            "responses": {
              "200": {
                "description": "Image bytes",
                "schema": {
                  "type": "file"
                }
              },
              "400": {
                "description": "The image URL is missing or invalid"
              }
            },
            "x-ms-media-kind": "image"
          }
        }
      },
      "definitions": {
        "Product": {
          "type": "object",
          "properties": {
            "ean": {
              "type": "string",
              "description": "The barcode that was looked up.",
              "x-ms-summary": "EAN"
            },
            "name": {
              "type": "string",
              "description": "The product's name.",
              "x-ms-summary": "Name"
            },
            "brand": {
              "type": "string",
              "description": "The product's brand.",
              "x-ms-summary": "Brand"
            },
            "quantity": {
              "type": "string",
              "description": "The product's package quantity, e.g. '750g' or '1L'. Free text, not a number.",
              "x-ms-summary": "Quantity"
            },
            "imageUrl": {
              "type": "string",
              "description": "URL of the product's front-of-pack image.",
              "x-ms-summary": "Image URL"
            }
          }
        }
      }
    },
